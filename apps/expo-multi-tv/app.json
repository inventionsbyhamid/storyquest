{
  "expo": {
    "plugins": [
      "./plugins/withKotlinJvmTarget",
      "./plugins/withKeyEvent",
      "./plugins/withTvosDeploymentTarget",
      [
        "@react-native-tvos/config-tv",
        {
          "androidTVBanner": "./assets/tv_icons/android-tv-banner.png",
          "appleTVImages": {
            "icon": "./assets/tv_icons/icon-1280x768.png",
            "iconSmall": "./assets/tv_icons/icon-400x240.png",
            "iconSmall2x": "./assets/tv_icons/icon-800x480.png",
            "topShelf": "./assets/tv_icons/icon-1920x720.png",
            "topShelf2x": "./assets/tv_icons/icon-1920x720.png",
            "topShelfWide": "./assets/tv_icons/icon-1920x720.png",
            "topShelfWide2x": "./assets/tv_icons/icon-1920x720.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "kotlinVersion": "2.0.21",
            "compileSdkVersion": 36,
            "targetSdkVersion": 34,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "react-native-video",
        {
          "enableNotificationControls": false,
          "enableBackgroundAudio": false,
          "enableADSExtension": false,
          "enableCacheExtension": false,
          "androidExtensions": {
            "useExoplayerRtsp": false,
            "useExoplayerSmoothStreaming": true,
            "useExoplayerHls": false,
            "useExoplayerDash": false
          }
        }
      ],
      "./plugins/withFmtXcode26Fix"
    ],
    "name": "StoryQuest",
    "slug": "storyquest",
    "scheme": "storyquest",
    "android": {
      "package": "com.storyquest.tv",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C2240"
      }
    },
    "ios": {
      "bundleIdentifier": "com.storyquest.tv"
    },
    "newArchEnabled": false,
    "backgroundColor": "#1C2240",
    "web": {
      "name": "StoryQuest",
      "shortName": "StoryQuest",
      "backgroundColor": "#1C2240",
      "themeColor": "#1C2240"
    },
    "experiments": {
      "baseUrl": "/play"
    },
    "icon": "./assets/icon.png"
  }
}

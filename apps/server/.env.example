# StoryQuest server. Copy to .env and fill in what you need.
# Everything runs with fake providers and no keys by default.

# Server
PORT=8080
HOST=0.0.0.0
# Used to build absolute media and share URLs. Set to the public https address in production.
PUBLIC_BASE_URL=http://localhost:8080
# Set to true behind a reverse proxy so rate limits see the real client address.
TRUST_PROXY=false
DATA_DIR=./data
LOG_LEVEL=info

# Director, the model that writes the story:
#   fake        scripted stand in, no key
#   bedrock     Claude on Amazon Bedrock
#   anthropic   Claude from the Anthropic API
#   openrouter  any model on OpenRouter, Claude by default
#   openai      any OpenAI compatible API: OpenAI, Groq, Together, DeepSeek, Gemini, Ollama, vLLM
# Switching only needs DIRECTOR and that provider's key. Each one defaults to Claude Opus 5.5
# under its own name (anthropic.claude-opus-5-5, claude-opus-5-5, anthropic/claude-opus-5.5).
DIRECTOR=fake
# Set to use another model, for example google/gemini-3.8-flash on OpenRouter. Required for openai.
DIRECTOR_MODEL=
# How long the model thinks: none, minimal, low, medium, high, xhigh or max. Defaults to low
# for Claude (none and minimal are not allowed there). Other models get it only when set.
DIRECTOR_EFFORT=

AWS_REGION=us-east-1
# Bedrock API key (bearer token). Leave empty to use the normal AWS credential chain.
BEDROCK_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

ANTHROPIC_API_KEY=

OPENROUTER_API_KEY=
# OpenRouter hosts to use, in order, with no fallback to others. amazon-bedrock keeps Claude
# running on Amazon Bedrock; clear it for a model Bedrock does not host. Empty lets OpenRouter
# pick. Hosts that keep or train on prompts are always skipped.
OPENROUTER_PROVIDERS=amazon-bedrock
# price, throughput or latency. throughput picks the fastest host, often 10 times quicker.
OPENROUTER_SORT=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Video: fake (local ffmpeg) or fal
VIDEO=fake
FAL_KEY=
FAL_MODEL_T2V=minimax/h3-max-turbo/text-to-video
FAL_MODEL_I2V=minimax/h3-max-turbo/image-to-video
VIDEO_RESOLUTION=768P
# Seconds per clip, 15 at most. A chapter's clips play back to back before each choice.
SCENE_SECONDS=15
CLIPS_PER_CHAPTER=3
PROMPT_EXPANSION=disabled
# fal price per video second from Nov 1 (0.60 per 15 second clip). The promo price until Oct 31 is 0.026.
VIDEO_PRICE_PER_SECOND=0.04
# Director prices in dollars per million tokens, used for the spend report only.
# The defaults are Claude Opus 5.5 on Bedrock in US regions; set your model's prices if you switch.
DIRECTOR_INPUT_PRICE_PER_MTOK=4.4
DIRECTOR_OUTPUT_PRICE_PER_MTOK=22
FAKE_VIDEO_DELAY_MS=2500
FAKE_VIDEO_SIZE=1344x768
FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Safety: wordlist or guardrails (Amazon Bedrock Guardrails plus the word list)
SAFETY=wordlist
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# Admin routes are disabled while this is empty. Use at least 16 random characters.
ADMIN_TOKEN=

# Sparks and Amazon In App Purchasing
# fake accepts receipt ids that start with fake-, sandbox verifies App Tester receipts,
# production verifies real Appstore receipts with the Receipt Verification Service.
IAP_MODE=fake
# Developer Console shared secret. Needed for sandbox and production, never logged.
AMAZON_IAP_SHARED_SECRET=
# Sparks per chapter filmed only for one family. Shared daily story paths are free.
SCENE_COST_SPARKS=3
# Free Sparks for every new user, once for life. 3 is one chapter.
WELCOME_FREE_SPARKS=3
# Extra free Sparks per TV per UTC day, for judging and promotions.
DAILY_FREE_SPARKS=0
SPARK_PRODUCTS=storyquest.sparks.10:10,storyquest.sparks.25:25

# Story engine and limits
DAILY_IDEAS=6
# How many days each set of daily stories stays on Home.
IDEA_LIFETIME_DAYS=1
# Chapters per story.
SCENES_PER_STORY=4
MAX_PARALLEL_JOBS=6
WARM_DEPTH=1
# Hard safety cap on private clips per TV per day, free or paid.
DEVICE_DAILY_CUSTOM_LIMIT=60
# Seconds of new video per UTC day across all families. A warning is logged at 80%.
DAILY_VIDEO_SECONDS_CAP=900
# Lifetime caps kept in the database, so restarts do not reset them. 0 means no cap.
# Every fal render counts, including failed ones fal may still bill.
TOTAL_VIDEO_SECONDS_CAP=0
# Every director request counts, retries, story bibles and the daily planner included.
DIRECTOR_CALL_CAP=0
# When false, nothing is filmed ahead: no prefetch on arrival or focus, no warming.
# A chapter is only made when a family chooses it or an admin films it.
AUTO_PREFETCH=true
# When false, no new daily stories are planned or filmed, and every filmed story stays on Home.
DAILY_PLANNER=true

# Website and policy pages served at /, /privacy, /terms and /support
SITE_DIR=site
COMPANY_NAME=StoryQuest
SUPPORT_EMAIL=
POLICY_UPDATED=October 18, 2026

# Testing on a tiny budget: real providers, nothing filmed ahead, hard lifetime caps.
# About 16 clips (five chapters) of video and 80 director requests at most, whatever happens.
# Create the stories once with POST /v1/admin/daily, film the paths you want to show with
# POST /v1/admin/film, and watch GET /v1/admin/spend.
# DIRECTOR=bedrock (or openrouter)
# VIDEO=fal
# SAFETY=guardrails
# AUTO_PREFETCH=false
# DAILY_PLANNER=false
# DAILY_IDEAS=3
# WARM_DEPTH=0
# TOTAL_VIDEO_SECONDS_CAP=240
# DIRECTOR_CALL_CAP=80

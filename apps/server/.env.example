# StoryQuest server. Copy to .env and fill in what you need.
# Everything runs with fake providers and no keys by default.

# Server
PORT=8080
HOST=0.0.0.0
# Used to build absolute media and share URLs. Set to the public https address in production.
PUBLIC_BASE_URL=http://localhost:8080
# Set to true behind a reverse proxy so rate limits see the real client address.
TRUST_PROXY=false
DATA_DIR=./data
LOG_LEVEL=info

# Director: fake or bedrock (Claude on Amazon Bedrock)
DIRECTOR=fake
BEDROCK_MODEL=anthropic.claude-opus-5-5
BEDROCK_EFFORT=low
AWS_REGION=us-east-1
# Bedrock API key (bearer token). Leave empty to use the normal AWS credential chain.
BEDROCK_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Video: fake (local ffmpeg) or fal
VIDEO=fake
FAL_KEY=
FAL_MODEL_T2V=minimax/h3-max-turbo/text-to-video
FAL_MODEL_I2V=minimax/h3-max-turbo/image-to-video
VIDEO_RESOLUTION=768P
SCENE_SECONDS=8
PROMPT_EXPANSION=disabled
VIDEO_PRICE_PER_SECOND=0.026
FAKE_VIDEO_DELAY_MS=2500
FAKE_VIDEO_SIZE=1344x768
FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Safety: wordlist or guardrails (Amazon Bedrock Guardrails plus the word list)
SAFETY=wordlist
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# Admin routes are disabled while this is empty. Use at least 16 random characters.
ADMIN_TOKEN=

# Story engine and limits
DAILY_IDEAS=6
SCENES_PER_STORY=6
MAX_PARALLEL_JOBS=6
WARM_DEPTH=1
DEVICE_DAILY_CUSTOM_LIMIT=12
# Seconds of new video per UTC day across all families. A warning is logged at 80%.
DAILY_VIDEO_SECONDS_CAP=900
